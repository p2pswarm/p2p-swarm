{
  "name": "p2p-swarm",
  "version": "0.1.0",
  "description": "A serverless peer-to-peer job swarm for Claude Code sessions. Post work, share a link, and let any Claude on the network pick it up.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "swarm": "bin/swarm.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test --test-timeout=60000 test/core.test.js test/network.test.js test/daemon.test.js test/stress.test.js",
    "daemon": "node src/daemon/main.js"
  },
  "keywords": [
    "p2p",
    "claude",
    "claude-code",
    "mcp",
    "swarm",
    "agents",
    "hyperswarm",
    "dht"
  ],
  "dependencies": {
    "hyperdht": "^6.36.0",
    "hyperswarm": "^4.17.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lordx64/p2p-swarm.git"
  }
}
